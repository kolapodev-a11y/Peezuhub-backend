# ─── Core ─────────────────────────────────────────────────────────────────────
PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/peezuhub?retryWrites=true&w=majority&appName=PeezuHub
JWT_SECRET=change_me_to_a_long_random_secret
APP_NAME=PeezuHub
CLIENT_URL=https://peezu-hub-new.vercel.app
ADMIN_DASHBOARD_URL=https://peezu-hub-new.vercel.app/admin
ADMIN_EMAIL=peezutech@gmail.com

# ─── Google OAuth (for Google Sign-In only – NOT used for email) ───────────────
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# ─── Paystack ──────────────────────────────────────────────────────────────────
PAYSTACK_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_live_xxxxxxxxxxxxxxxxxxxxx

# ─── Resend (email delivery) ───────────────────────────────────────────────────
# Get your API key at https://resend.com/api-keys
# Verify your sending domain at https://resend.com/domains
#
# RESEND_API_KEY      – required. Paste your key here.
# RESEND_FROM_EMAIL   – required in production. Must match a verified Resend domain.
#                       Format: "Display Name <sender@yourdomain.com>"
# RESEND_REPLY_TO     – optional. Reply-to address shown to email recipients.
#
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=PeezuHub <noreply@peezuhub.name.ng>
RESEND_REPLY_TO=support@peezuhub.name.ng

# ─── Removed (no longer used) ─────────────────────────────────────────────────
# SMTP_SERVICE, SMTP_USER, SMTP_PASS, SMTP_FROM  → replaced by Resend
# COURIER_API_KEY, COURIER_FROM_EMAIL, COURIER_REPLY_TO  → replaced by Resend
# GOOGLE_CLIENT_SECRET, GOOGLE_REFRESH_TOKEN  → only needed for Gmail API, now removed
