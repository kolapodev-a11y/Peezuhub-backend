PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/peezuhub?retryWrites=true&w=majority&appName=PeezuHub
JWT_SECRET=change_me_to_a_long_random_secret
APP_NAME=PeezuHub
CLIENT_URL=http://localhost:5173
ADMIN_DASHBOARD_URL=http://localhost:5173/admin
ADMIN_EMAIL=peezutech@gmail.com
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxx
SMTP_SERVICE=gmail
SMTP_USER=peezutech@gmail.com
SMTP_PASS=your_gmail_app_password
SMTP_FROM=PeezuHub <peezutech@gmail.com>

# The current codebase sends branded emails with src/utils/sendEmail.js and src/utils/emailTemplates.js.
# COURIER_* values are not used by these repositories and can be removed from production if no other service needs them.
COURIER_API_KEY=
COURIER_FROM_EMAIL=
COURIER_REPLY_TO=
