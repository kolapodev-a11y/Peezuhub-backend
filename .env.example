PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/peezuhub?retryWrites=true&w=majority&appName=PeezuHub
JWT_SECRET=change_me_to_a_long_random_secret
APP_NAME=PeezuHub
CLIENT_URL=http://localhost:5173
ADMIN_DASHBOARD_URL=http://localhost:5173/admin
ADMIN_EMAIL=peezutech@gmail.com
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxx

# Preferred / restored setup for Render free plan:
# Courier handles the actual provider delivery, so SMTP vars are not required.
COURIER_API_KEY=your_courier_api_key
COURIER_FROM_EMAIL=PeezuHub <peezutech@gmail.com>
COURIER_REPLY_TO=peezutech@gmail.com

# Optional fallback modes only if you intentionally want them.
# Leave these blank when using Courier.
EMAIL_DELIVERY_MODE=auto
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
SMTP_SERVICE=
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
